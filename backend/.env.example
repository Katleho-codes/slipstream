# Database
DATABASE_URL="postgresql://slipstream:password@localhost:5432/slipstream_db"

# Server
PORT=8003
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET="change-this-to-a-long-random-string-minimum-32-chars"
BETTER_AUTH_URL="http://localhost:8003"   # base URL of this API

# HMAC signing for QR verify tokens
VERIFY_HMAC_SECRET="change-this-to-another-long-random-string"

# Resend (email delivery)
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="payslips@slipstream.co.za"
RESEND_FROM_NAME="SlipStream Payslips"

# App URLs
VERIFY_BASE_URL="http://localhost:8003/api/verify"
FRONTEND_URL="http://localhost:3003"

# PDF storage (local for dev — swap for Cloudflare R2 in prod)
PDF_STORAGE_PATH="./storage/pdfs"
